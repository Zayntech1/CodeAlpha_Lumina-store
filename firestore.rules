rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: Publicly readable for the shop
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // Allow signed-in users to seed/manage for now
    }

    // Users: Owners can manage their profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: Signed-in users can create and read their own orders
    match /orders/{orderId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
